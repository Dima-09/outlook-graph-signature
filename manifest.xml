<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>e89ae6dd-8827-4484-94f4-9a41938ad331</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>BDO Qazaqstan</ProviderName>
  <DefaultLocale>ru-RU</DefaultLocale>
  <DisplayName DefaultValue="BDO Auto Signature"/>
  <Description DefaultValue="Автоматическая корпоративная подпись BDO Qazaqstan через Microsoft Graph"/>

  <IconUrl DefaultValue="https://dima-09.github.io/outlook-graph-signature/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://dima-09.github.io/outlook-graph-signature/icon-80.png"/>
  <SupportUrl DefaultValue="https://dima-09.github.io/outlook-graph-signature/commands.html"/>

  <AppDomains>
    <AppDomain>https://dima-09.github.io</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.10"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://dima-09.github.io/outlook-graph-signature/commands.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <Sets>
          <Set Name="Mailbox" MinVersion="1.10"/>
        </Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="CommandsUrl">
              <Override type="javascript" resid="CommandsJsUrl"/>
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <FunctionFile resid="CommandsUrl"/>
            <ExtensionPoint xsi:type="Events">
              <Event Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler"/>
              <Event Type="OnMessageRecipientsChanged" FunctionName="onMessageRecipientsChangedHandler"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="https://dima-09.github.io/outlook-graph-signature/icon-16.png"/>
          <bt:Image id="Icon32" DefaultValue="https://dima-09.github.io/outlook-graph-signature/icon-32.png"/>
          <bt:Image id="Icon80" DefaultValue="https://dima-09.github.io/outlook-graph-signature/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="CommandsUrl" DefaultValue="https://dima-09.github.io/outlook-graph-signature/commands.html"/>
          <bt:Url id="CommandsJsUrl" DefaultValue="https://dima-09.github.io/outlook-graph-signature/commands.js"/>
        </bt:Urls>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>